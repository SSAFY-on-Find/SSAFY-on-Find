pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = "pug9483"
        BE_IMAGE_NAME = "${DOCKERHUB_USERNAME}/chelsea-be-app"
    }

    stages {
        stage('Check Docker Installation') {
            steps {
                script {
                    sh 'which docker'
                    sh 'docker --version'
                }
            }
        }

        stage('Checkout Source Code') {
            steps {
                git branch: 'test-master',
                    credentialsId: 'jenkins_token', 
                    url: 'https://lab.ssafy.com/s13-webmobile1-sub1/S13P11A704.git'
            }
        }

        stage("Build BE Image") {
            steps {
                script {
                    def imageTag = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    sh "docker build -f INFRA/BE.Dockerfile -t ${env.BE_IMAGE_NAME}:${imageTag} BE/chelsea"
                    sh "docker tag ${env.BE_IMAGE_NAME}:${imageTag} ${env.BE_IMAGE_NAME}:latest"
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-token', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh "echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin"
                    sh "docker push --all-tags ${env.BE_IMAGE_NAME}"
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                script {
                    def imageTag = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    sshagent(credentials: ['ec2-deploy-key']) {
                        def ec2_host = 'ubuntu@i13a704.p.ssafy.io'
                        sh "scp -o StrictHostKeyChecking=no ./INFRA/deploy.sh ${ec2_host}:/home/ubuntu/deploy.sh"
                        sh "ssh -o StrictHostKeyChecking=no ${ec2_host} 'chmod +x /home/ubuntu/deploy.sh && /home/ubuntu/deploy.sh ${env.BE_IMAGE_NAME}:latest'"
                    }
                }
            }
        }
    }

     post {
        always {
            echo 'Cleaning up...'
            sh 'docker logout'
            cleanWs()
        }
    }
}